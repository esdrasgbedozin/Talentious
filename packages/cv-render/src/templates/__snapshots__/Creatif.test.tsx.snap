exports[`Creatif — rend les fixtures canoniques GeneratedCVData (M3-T05) snapshot du CV « minimal » 1`] = `"<div class="cv-sheet relative mx-auto overflow-hidden" style="--cv-accent: #2D3748; --cv-text: #1A202C; --cv-muted: #4A5568; --cv-background: #FFFFFF; --cv-font-heading: &quot;Inter&quot;, sans-serif; --cv-font-body: &quot;Inter&quot;, sans-serif; width: 210mm; height: 297mm; background-color: var(--cv-background); color: var(--cv-text); font-family: var(--cv-font-body);"><div style="padding: 14mm 16mm;"><div data-cv-content="true" class="text-[11px] leading-relaxed" style="transform-origin: top center;"><header class="mb-5"><h1 class="text-[32px] font-bold leading-tight tracking-tight" style="font-family: var(--cv-font-heading);"><span style="color: var(--cv-accent);">Sam</span> <span>Leroy</span></h1><div class="mt-2 h-1 w-24 rounded-full" style="background-color: var(--cv-accent);" aria-hidden="true"></div><p class="mt-2.5 flex flex-wrap gap-x-2 gap-y-0.5 text-[10px]" style="color: var(--cv-muted);"><span class="flex items-center gap-2">sam.leroy@example.com</span></p></header><section class="mb-5"><h2 class="mb-2 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.1em]" style="font-family: var(--cv-font-heading); color: var(--cv-accent);"><span aria-hidden="true" class="inline-block h-2 w-2 flex-shrink-0 rounded-[1px]" style="background-color: var(--cv-accent);"></span>Profil</h2><p class="whitespace-pre-line">Développeur junior en reconversion, motivé par le web et l'accessibilité.</p></section><section class="mb-5"><h2 class="mb-2 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.1em]" style="font-family: var(--cv-font-heading); color: var(--cv-accent);"><span aria-hidden="true" class="inline-block h-2 w-2 flex-shrink-0 rounded-[1px]" style="background-color: var(--cv-accent);"></span>Expérience professionnelle</h2><div class="space-y-3"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Stagiaire développeur web<span class="font-normal" style="color: var(--cv-muted);"> — Studio Tangram</span></h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">févr. 2024 — aujourd'hui</span></div><p class="mt-1 whitespace-pre-line">Intégration de maquettes et correction de bugs front.</p><p class="mt-1 text-[10px]" style="color: var(--cv-muted);">HTML · CSS · JavaScript</p></div></div></section><section class="mb-5 break-inside-avoid"><h2 class="mb-2 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.1em]" style="font-family: var(--cv-font-heading); color: var(--cv-accent);"><span aria-hidden="true" class="inline-block h-2 w-2 flex-shrink-0 rounded-[1px]" style="background-color: var(--cv-accent);"></span>Compétences</h2><div class="mb-2 flex flex-wrap items-baseline gap-x-2 gap-y-1.5"><span class="font-semibold">Techniques : </span><span class="inline-flex flex-wrap gap-1.5 align-middle"><span class="rounded-full border px-2.5 py-0.5 text-[10px] font-medium" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent); border-color: color-mix(in srgb, var(--cv-accent) 35%, transparent); color: var(--cv-text);">JavaScript</span></span></div><div class="flex flex-wrap items-baseline gap-x-2 gap-y-1.5"><span class="font-semibold">Transversales : </span><span class="inline-flex flex-wrap gap-1.5 align-middle"><span class="rounded-full border px-2.5 py-0.5 text-[10px] font-medium" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent); border-color: color-mix(in srgb, var(--cv-accent) 35%, transparent); color: var(--cv-text);">Rigueur</span></span></div></section><section class="mb-5"><h2 class="mb-2 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.1em]" style="font-family: var(--cv-font-heading); color: var(--cv-accent);"><span aria-hidden="true" class="inline-block h-2 w-2 flex-shrink-0 rounded-[1px]" style="background-color: var(--cv-accent);"></span>Formation</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Titre professionnel Développeur web</h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);"></span></div><p class="text-[10px]" style="color: var(--cv-muted);">AFPA</p></div></div></section></div></div></div>"`;
