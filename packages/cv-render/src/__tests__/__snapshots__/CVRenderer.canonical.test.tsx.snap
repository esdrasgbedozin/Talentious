exports[`CVRenderer — rend les fixtures canoniques GeneratedCVData (M0-T08b) snapshot du CV « complete » 1`] = `"<div class="cv-sheet relative mx-auto overflow-hidden bg-white text-text-primary" style="width: 210mm; height: 297mm;"><div style="padding: 14mm 16mm;"><div class="text-[11px] leading-relaxed" style="transform-origin: top center;"><header class="mb-4"><h1 class="text-3xl font-bold tracking-tight text-primary">Camille Fontaine</h1><p class="mt-2 flex flex-wrap gap-x-2 gap-y-0.5 text-[11px] text-text-secondary"><span class="flex items-center gap-2">camille.fontaine@example.com</span><span class="flex items-center gap-2"><span class="text-border">•</span>+33 6 12 34 56 78</span><span class="flex items-center gap-2"><span class="text-border">•</span>Lyon, France</span><span class="flex items-center gap-2"><span class="text-border">•</span>https://www.linkedin.com/in/camille-fontaine</span></p></header><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Profil</h2><p class="whitespace-pre-line text-text-primary">Ingénieure logicielle avec huit ans d'expérience sur des plateformes distribuées à fort trafic. Spécialiste Python et des architectures orientées événements, je pilote des équipes produit de bout en bout, de la conception à l'exploitation.</p></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Expérience professionnelle</h2><div class="space-y-3"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Ingénieure logicielle senior<span class="font-normal text-text-secondary"> — Novacité</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">mars 2021 — aujourd'hui</span></div><p class="text-[10px] italic text-text-secondary">Lyon</p><p class="mt-1 whitespace-pre-line text-text-primary">Conception et exploitation d'une plateforme de paiement traitant 3 millions de transactions par jour. Réduction de 40 % de la latence p99 par refonte du pipeline asynchrone.</p><p class="mt-0.5 text-[10px] text-text-secondary">Python · FastAPI · PostgreSQL · Observabilité</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Ingénieure backend<span class="font-normal text-text-secondary"> — Atelier Data</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">janv. 2018 — févr. 2021</span></div><p class="text-[10px] italic text-text-secondary">Grenoble</p><p class="mt-1 whitespace-pre-line text-text-primary">Développement d'API internes et de pipelines de données. Mise en place de la CI/CD et des tests de non-régression.</p><p class="mt-0.5 text-[10px] text-text-secondary">Python · Docker · CI/CD</p></div></div></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Formation</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Diplôme d'ingénieur en informatique</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">sept. 2017</span></div><p class="text-[10px] text-text-secondary">INSA Lyon</p><p class="mt-0.5 whitespace-pre-line text-text-primary">Spécialisation systèmes et réseaux.</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Compétences</h2><div class="mb-1.5"><span class="font-semibold text-text-primary">Techniques : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Python</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">FastAPI</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">PostgreSQL</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Architecture distribuée</span></span></div><div><span class="font-semibold text-text-primary">Transversales : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Communication</span></span></div></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Projets</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Observatoire open data des mobilités</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">juin 2022</span></div><p class="mt-0.5 whitespace-pre-line text-text-primary">Plateforme bénévole d'agrégation de données de transport en temps réel.</p><p class="mt-0.5 text-[10px] text-text-secondary">Python · GTFS · Cartographie</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Certifications</h2><div class="space-y-1"><div class="flex items-baseline justify-between gap-3"><span class="text-text-primary"><span class="font-semibold">Professional Cloud Architect</span><span class="text-text-secondary"> — Google Cloud</span></span><span class="flex-shrink-0 text-[10px] text-text-secondary">avr. 2023</span></div></div></section></div></div></div>"`;

exports[`CVRenderer — rend les fixtures canoniques GeneratedCVData (M0-T08b) snapshot du CV « dense » 1`] = `"<div class="cv-sheet relative mx-auto overflow-hidden bg-white text-text-primary" style="width: 210mm; height: 297mm;"><div style="padding: 14mm 16mm;"><div class="text-[11px] leading-relaxed" style="transform-origin: top center;"><header class="mb-4"><h1 class="text-3xl font-bold tracking-tight text-primary">Amina Benkacem</h1><p class="mt-2 flex flex-wrap gap-x-2 gap-y-0.5 text-[11px] text-text-secondary"><span class="flex items-center gap-2">amina.benkacem@example.com</span><span class="flex items-center gap-2"><span class="text-border">•</span>+33 7 98 76 54 32</span><span class="flex items-center gap-2"><span class="text-border">•</span>Toulouse, France</span><span class="flex items-center gap-2"><span class="text-border">•</span>https://www.linkedin.com/in/amina-benkacem</span></p></header><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Profil</h2><p class="whitespace-pre-line text-text-primary">Directrice technique avec quinze ans d'expérience à la croisée du produit, de l'ingénierie et du management. J'ai bâti et fait grandir des équipes de plus de trente personnes, défini des stratégies techniques pluriannuelles et livré des produits SaaS de l'amorçage à la série C, en gardant la qualité et la fiabilité au centre des décisions.</p></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Expérience professionnelle</h2><div class="space-y-3"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Directrice technique<span class="font-normal text-text-secondary"> — Heliosoft</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">sept. 2020 — aujourd'hui</span></div><p class="text-[10px] italic text-text-secondary">Toulouse</p><p class="mt-1 whitespace-pre-line text-text-primary">Définition de la stratégie technique et management de cinq équipes (32 personnes). Migration vers une architecture multi-tenant, division par trois du coût d'infrastructure par client et mise en place d'une culture de fiabilité (SLO, post-mortems sans blâme).</p><p class="mt-0.5 text-[10px] text-text-secondary">Leadership · Architecture cloud · SRE · Stratégie produit</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Lead ingénierie plateforme<span class="font-normal text-text-secondary"> — Dataforge</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">avr. 2017 — août 2020</span></div><p class="text-[10px] italic text-text-secondary">Paris</p><p class="mt-1 whitespace-pre-line text-text-primary">Création de l'équipe plateforme et de son socle (CI/CD, observabilité, self-service). Réduction du délai de mise en production de deux semaines à une heure.</p><p class="mt-0.5 text-[10px] text-text-secondary">Kubernetes · Terraform · CI/CD · Observabilité</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Ingénieure logicielle senior<span class="font-normal text-text-secondary"> — Novatek</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">juin 2014 — mars 2017</span></div><p class="text-[10px] italic text-text-secondary">Nantes</p><p class="mt-1 whitespace-pre-line text-text-primary">Conception de services backend critiques et mentorat des profils juniors.</p><p class="mt-0.5 text-[10px] text-text-secondary">Go · PostgreSQL · Systèmes distribués</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Ingénieure logicielle<span class="font-normal text-text-secondary"> — Studio Comète</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">sept. 2011 — mai 2014</span></div><p class="text-[10px] italic text-text-secondary">Bordeaux</p><p class="mt-1 whitespace-pre-line text-text-primary">Développement full-stack d'applications métier pour des clients grands comptes.</p><p class="mt-0.5 text-[10px] text-text-secondary">Java · Spring · SQL</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Développeuse junior<span class="font-normal text-text-secondary"> — Webfabrik</span></h3><span class="flex-shrink-0 text-[10px] text-text-secondary">oct. 2009 — août 2011</span></div><p class="text-[10px] italic text-text-secondary">Bordeaux</p><p class="mt-1 whitespace-pre-line text-text-primary">Intégration et maintenance de sites e-commerce.</p><p class="mt-0.5 text-[10px] text-text-secondary">PHP · MySQL · JavaScript</p></div></div></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Formation</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Master informatique, spécialité systèmes distribués</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">juil. 2009</span></div><p class="text-[10px] text-text-secondary">Université de Bordeaux</p><p class="mt-0.5 whitespace-pre-line text-text-primary">Mémoire sur la tolérance aux pannes dans les systèmes pair-à-pair.</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Licence informatique</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">juil. 2007</span></div><p class="text-[10px] text-text-secondary">Université de Bordeaux</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Executive program - Leadership</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">nov. 2021</span></div><p class="text-[10px] text-text-secondary">HEC Paris</p><p class="mt-0.5 whitespace-pre-line text-text-primary">Programme court de management pour dirigeants techniques.</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Compétences</h2><div class="mb-1.5"><span class="font-semibold text-text-primary">Techniques : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Architecture cloud</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Kubernetes</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Terraform</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Go</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">PostgreSQL</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">SRE</span></span></div><div><span class="font-semibold text-text-primary">Transversales : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Leadership technique</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Stratégie produit</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Mentorat</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Communication</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Gestion budgétaire</span><span class="rounded bg-action/10 px-2 py-0.5 text-[10px] text-text-primary print:bg-action/10">Recrutement</span></span></div></section><section class="mb-4"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Projets</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Référentiel open source d'ingénierie de fiabilité</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">janv. 2022</span></div><p class="mt-0.5 whitespace-pre-line text-text-primary">Guide communautaire et outils d'audit de fiabilité adoptés par plusieurs entreprises françaises.</p><p class="mt-0.5 text-[10px] text-text-secondary">SRE · Documentation · Open source</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold text-text-primary">Conférence TechFiable</h3><span class="flex-shrink-0 text-[10px] text-text-secondary">oct. 2023</span></div><p class="mt-0.5 whitespace-pre-line text-text-primary">Co-organisation d'une conférence annuelle sur la fiabilité logicielle (400 participants).</p><p class="mt-0.5 text-[10px] text-text-secondary">Organisation · Communauté</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b border-border pb-1 text-[13px] font-bold uppercase tracking-wide text-action">Certifications</h2><div class="space-y-1"><div class="flex items-baseline justify-between gap-3"><span class="text-text-primary"><span class="font-semibold">Certified Kubernetes Administrator</span><span class="text-text-secondary"> — CNCF</span></span><span class="flex-shrink-0 text-[10px] text-text-secondary">mai 2019</span></div><div class="flex items-baseline justify-between gap-3"><span class="text-text-primary"><span class="font-semibold">Professional Cloud Architect</span><span class="text-text-secondary"> — Google Cloud</span></span><span class="flex-shrink-0 text-[10px] text-text-secondary">févr. 2021</span></div></div></section></div></div></div>"`;

