exports[`CVRenderer — rend les fixtures canoniques GeneratedCVData (M0-T08b) snapshot du CV « complete » 1`] = `"<div class="cv-sheet relative mx-auto overflow-hidden" style="--cv-accent: #2D3748; --cv-text: #1A202C; --cv-muted: #4A5568; --cv-background: #FFFFFF; --cv-font-heading: &quot;Inter&quot;, sans-serif; --cv-font-body: &quot;Inter&quot;, sans-serif; width: 210mm; height: 297mm; background-color: var(--cv-background); color: var(--cv-text); font-family: var(--cv-font-body);"><div style="padding: 14mm 16mm;"><div class="text-[11px] leading-relaxed" style="transform-origin: top center;"><header class="mb-4"><h1 class="text-3xl font-bold tracking-tight" style="font-family: var(--cv-font-heading);">Camille Fontaine</h1><p class="mt-2 flex flex-wrap gap-x-2 gap-y-0.5 text-[11px]" style="color: var(--cv-muted);"><span class="flex items-center gap-2">camille.fontaine@example.com</span><span class="flex items-center gap-2"><span style="color: var(--cv-muted);">•</span>+33 6 12 34 56 78</span><span class="flex items-center gap-2"><span style="color: var(--cv-muted);">•</span>Lyon, France</span><span class="flex items-center gap-2"><span style="color: var(--cv-muted);">•</span>https://www.linkedin.com/in/camille-fontaine</span></p></header><section class="mb-4"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Profil</h2><p class="whitespace-pre-line">Ingénieure logicielle avec huit ans d'expérience sur des plateformes distribuées à fort trafic. Spécialiste Python et des architectures orientées événements, je pilote des équipes produit de bout en bout, de la conception à l'exploitation.</p></section><section class="mb-4"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Expérience professionnelle</h2><div class="space-y-3"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Ingénieure logicielle senior<span class="font-normal" style="color: var(--cv-muted);"> — Novacité</span></h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">mars 2021 — aujourd'hui</span></div><p class="text-[10px] italic" style="color: var(--cv-muted);">Lyon</p><p class="mt-1 whitespace-pre-line">Conception et exploitation d'une plateforme de paiement traitant 3 millions de transactions par jour. Réduction de 40 % de la latence p99 par refonte du pipeline asynchrone.</p><p class="mt-0.5 text-[10px]" style="color: var(--cv-muted);">Python · FastAPI · PostgreSQL · Observabilité</p></div><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Ingénieure backend<span class="font-normal" style="color: var(--cv-muted);"> — Atelier Data</span></h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">janv. 2018 — févr. 2021</span></div><p class="text-[10px] italic" style="color: var(--cv-muted);">Grenoble</p><p class="mt-1 whitespace-pre-line">Développement d'API internes et de pipelines de données. Mise en place de la CI/CD et des tests de non-régression.</p><p class="mt-0.5 text-[10px]" style="color: var(--cv-muted);">Python · Docker · CI/CD</p></div></div></section><section class="mb-4"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Formation</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Diplôme d'ingénieur en informatique</h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">sept. 2017</span></div><p class="text-[10px]" style="color: var(--cv-muted);">INSA Lyon</p><p class="mt-0.5 whitespace-pre-line">Spécialisation systèmes et réseaux.</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Compétences</h2><div class="mb-1.5"><span class="font-semibold">Techniques : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded px-2 py-0.5 text-[10px]" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent);">Python</span><span class="rounded px-2 py-0.5 text-[10px]" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent);">FastAPI</span><span class="rounded px-2 py-0.5 text-[10px]" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent);">PostgreSQL</span><span class="rounded px-2 py-0.5 text-[10px]" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent);">Architecture distribuée</span></span></div><div><span class="font-semibold">Transversales : </span><span class="inline-flex flex-wrap gap-1 align-middle"><span class="rounded px-2 py-0.5 text-[10px]" style="background-color: color-mix(in srgb, var(--cv-accent) 10%, transparent);">Communication</span></span></div></section><section class="mb-4"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Projets</h2><div class="space-y-2"><div class="break-inside-avoid"><div class="flex items-baseline justify-between gap-3"><h3 class="font-semibold">Observatoire open data des mobilités</h3><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">juin 2022</span></div><p class="mt-0.5 whitespace-pre-line">Plateforme bénévole d'agrégation de données de transport en temps réel.</p><p class="mt-0.5 text-[10px]" style="color: var(--cv-muted);">Python · GTFS · Cartographie</p></div></div></section><section class="mb-4 break-inside-avoid"><h2 class="mb-2 border-b pb-1 text-[13px] font-bold uppercase tracking-wide" style="font-family: var(--cv-font-heading); color: var(--cv-accent); border-color: var(--cv-muted);">Certifications</h2><div class="space-y-1"><div class="flex items-baseline justify-between gap-3"><span><span class="font-semibold">Professional Cloud Architect</span><span style="color: var(--cv-muted);"> — Google Cloud</span></span><span class="flex-shrink-0 text-[10px]" style="color: var(--cv-muted);">avr. 2023</span></div></div></section></div></div></div>"`;

