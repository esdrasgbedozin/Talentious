    "esbuild": "0.28.2",
    "eslint": "^9",
    "openapi-typescript": "7.13.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
