    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.1",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10",
    "@napi-rs/canvas": "1.0.13",
    "@talentious/cv-render": "*",
    "@types/node": "^26",
    "@types/react": "^19",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "openapi-typescript": "7.13.0",
    "pdfjs-dist": "6.4.299",
    "pixelmatch": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
