{
  "name": "@talentious/export-service",
  "version": "0.1.0",
  "private": true,
  "description": "Service de rendu PDF déterministe (ADR-PDF-RENDER, Option B : payload injecté, aucune navigation). 6e service Cloud Run, privé (OIDC). Consomme @talentious/cv-render pour l'invariant « aperçu = PDF ».",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
