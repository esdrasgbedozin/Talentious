{
  "compilerOptions": {
    "target": "ES2022",
    // DOM + jsx : @talentious/cv-render est consommé EN SOURCE (.tsx, hooks
    // navigateur) et type-checké dans ce programme — même compromis que le
    // transpilePackages de Next. Le code du service lui-même reste du Node pur.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
